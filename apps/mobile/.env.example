# @openrd/mobile — build-time environment
#
# THIS FILE, NOT THE REPOSITORY ROOT .env, IS WHAT EXPO READS.
#
# Expo's dotenv loader resolves every candidate file against the Expo
# *project root* — the directory holding app.json, i.e. apps/mobile.
# The repository-root .env is loaded by the API and by docker compose;
# Expo never sees it. Setting EXPO_PUBLIC_API_URL there and running
# `npm run dev:mobile` or `npx expo export` produces a bundle with no
# API URL at all, which is exactly the misconfiguration lib/api.ts now
# refuses to boot with in a production build.
#
# Copy to `.env` in THIS directory (apps/mobile/.env) and fill in:
#
#     cp apps/mobile/.env.example apps/mobile/.env
#
# Every EXPO_PUBLIC_* value is INLINED INTO THE BUNDLE at build time
# and is readable by anyone who has the app. Never put a secret here.
#
# The Docker web build does not use this file: apps/mobile/Dockerfile.web
# takes EXPO_PUBLIC_API_URL as a build ARG (default `/api`, correct
# behind Caddy), fed from docker-compose.yml's WEB_EXPO_PUBLIC_API_URL.

# Base URL of the API, including the /api prefix.
#   local dev against `npm run dev:api`  -> http://localhost:4000/api
#   physical device on the same wifi     -> http://<your-lan-ip>:4000/api
#   same-origin deploy behind Caddy      -> /api
#   separate host                        -> https://ai.fshdyouth.com/api
#
# Leave it unset only for local development: lib/api.ts falls back to
# localhost when NODE_ENV is not production, and throws at module load
# when it is, so a misbuilt release fails on first launch instead of
# silently dialling a host that does not exist on the patient's phone.
EXPO_PUBLIC_API_URL=http://localhost:4000/api

# ---------------------------------------------------------------------
# Feature flags (lib/feature-flags.ts). Both default to false; accepted
# truthy values are 1 / true / yes. These are build-time, not runtime —
# flipping one requires a rebuild. The Docker web image takes both as
# build ARGs (Dockerfile.web) fed from the web service's args in
# docker-compose.yml, so a compose build reads them from the shell
# environment or the repository-root .env rather than from this file.
# ---------------------------------------------------------------------

# Surface the 探索 · 即将上线 group in Settings, where every row still
# opens an UnavailableScreen. Which destinations are in that group is a
# question for the group itself, in screens/p-settings — a second copy
# of the list here is what goes stale. The routes stay in the tree
# either way; this governs discoverability only.
# EXPO_PUBLIC_ENABLE_EXPLORE=false

# Surface the 个性化设置 entry (大字体 / 语音读屏 / 高对比度). Off until
# it does something: it currently opens a「即将上线」alert, and telling
# the people who need accessibility to wait is worse than not offering
# the row at all.
# EXPO_PUBLIC_ENABLE_PERSONALIZATION=false
