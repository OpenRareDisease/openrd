{
  "expo": {
    "name": "肌愈通",
    "slug": "jiyutong",
    "version": "2.5.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon_downloaded.png",
    "scheme": "jiyutong",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fshdyouth.jiyutong",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.fshdyouth.jiyutong",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "肌愈通需要使用相机拍摄化验单、检查报告等纸质材料，用来自动识别其中的指标并存进你自己的健康档案。不会在后台拍摄，也不会用于其他用途。",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
