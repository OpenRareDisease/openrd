{
  "expo": {
    "name": "肌愈通",
    "slug": "jiyutong",
    "version": "2.5.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon_downloaded.png",
    "scheme": "jiyutong",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fshdyouth.jiyutong",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.fshdyouth.jiyutong",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "肌愈通",
      "shortName": "肌愈通",
      "lang": "zh-Hans-CN",
      "themeColor": "#FBF8F3",
      "description": "面向面肩肱型肌营养不良（FSHD）患者的自我管理平台：记录症状与肌力变化，整理化验单和检查报告，查阅带出处的疾病知识。"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "肌愈通需要使用相机拍摄化验单、检查报告等纸质材料，用来自动识别其中的指标并存进你自己的健康档案。不会在后台拍摄，也不会用于其他用途。",
          "photosPermission": "肌愈通需要读取你选中的化验单、检查报告图片，用来识别其中的指标并存进你自己的健康档案。只会读取你每次主动选择的那几张，不会浏览相册里的其他照片。",
          "microphonePermission": false
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
