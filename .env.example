# ⚠️ STAGING AND PRODUCTION MUST SET NODE_ENV=production (or =staging).
# This single line is the master switch for the entire boot-time
# fail-fast block in apps/api/src/config/env.ts: validateProductionEnv
# returns immediately unless NODE_ENV is `production` or `staging`. Left
# unset (or `development`) NOTHING below is checked — a forgotten
# JWT_SECRET silently stays `change-me-super-secret`, CORS_ORIGIN stays
# `*`, OTP_PROVIDER=mock is accepted, the KB service accepts its
# dev-only placeholder token, and an unencrypted DB connection carrying
# PHI raises no objection. The deploy runbook's「缺一项 prod 启动
# fail-fast」promise is only true when this is set.
#
# It is deliberately left COMMENTED here so that copying this file gives
# you a working dev environment (env.ts defaults to `development`) and
# so a production operator has to make the choice explicitly rather than
# inherit a value they never read.
# NODE_ENV=production
PORT=4000
POSTGRES_PORT=5432
# REQUIRED. docker-compose declares this as ${POSTGRES_PASSWORD:?...} with no
# default in three places, so `docker compose config` fails outright when it is
# unset — deliberately, because the PHI database used to run on a hardcoded
# postgres/postgres that no .env value could override. Local dev may keep
# `postgres`; production must not, and env.ts rejects that pair regardless of
# hostname when NODE_ENV is production/staging.
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres
# DELIBERATELY COMMENTED OUT. The host part of this URL is the one
# setting whose correct value differs between the two supported ways of
# running the API, and there is no single string that serves both:
#
#   npm run dev:api (bare metal)  → Postgres is at localhost:5432
#   docker compose up             → Postgres is the `postgres` service;
#                                   localhost inside the api container
#                                   is the api container
#
# Left commented, BOTH work from an unmodified copy of this file: env.ts
# defaults to `postgres://postgres:postgres@localhost:5432/fshd_openrd`
# for the native run, and docker-compose.yml defaults the api service to
# `postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/
# fshd_openrd`. Uncommenting the localhost form and then running compose
# hands the container an address where nothing listens; the api boots
# with an error naming this variable (validateContainerTopologyEnv),
# which is the only reason that is a five-second fix rather than a
# migrate.js ECONNREFUSED restart loop.
#
# SET IT when the database is somewhere both contexts can reach by the
# same name — a managed instance per runbook §1.4. Compose passes an
# explicit DATABASE_URL straight through, so that override is the point.
# The host-side scripts (npm run db:backup / db:restore / kb:prune /
# dev-grant-consent) read it too: against the compose stack, give them
# the localhost form per invocation
# (`DATABASE_URL=postgres://…@localhost:5432/fshd_openrd npm run
# db:backup`) rather than putting it back in this file.
#
# In production it MUST be a dedicated role with its own password: prod
# boot rejects ANY connection string still carrying the
# `postgres:postgres` credential pair published in this repo (it is a
# Postgres superuser), regardless of host — so the compose form
# `postgres://postgres:postgres@postgres:5432/...` is rejected too.
# Reaching a compose-internal Postgres by the hostname `postgres` is
# fine; reusing the shipped password is not.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/fshd_openrd
# DB SSL is gated SOLELY on this flag — NOT forced by NODE_ENV. A
# REMOTE / managed DB (RDS, Cloud SQL, …) MUST set it true (and
# configure DATABASE_SSL_REJECT_UNAUTHORIZED as appropriate). For a
# compose-internal / private-network Postgres that speaks no SSL,
# leave it false AND set DATABASE_ALLOW_INSECURE=true below.
DATABASE_SSL_ENABLED=false
# Certificate verification, and the reason DATABASE_SSL_ENABLED alone is
# not the whole story: `true/false` is an ENCRYPTED BUT UNAUTHENTICATED
# connection — anything on the path can present its own certificate and
# read the PHI going over it — while the boot log and the health summary
# both say SSL is on. Prod/staging refuses that pair unless
# DATABASE_ALLOW_INSECURE=true acknowledges it, which is the escape
# hatch for a provider whose cert is signed by a private CA.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Explicit ack that an unencrypted prod DB connection is intentional.
# Prod fail-fasts when SSL is off and this is not set — so a remote DB
# that forgot DATABASE_SSL_ENABLED can't silently send PHI in cleartext.
# Set true ONLY for a compose-internal / private-network Postgres.
DATABASE_ALLOW_INSECURE=false
# Connections the pool will open, and how long a request waits for a
# free one. The timeout matters most: pg-pool's default is 0, meaning
# "wait forever", so a saturated DB produces requests that never answer
# and never fail. Raise POOL_MAX per instance only if Postgres's own
# max_connections has room for (instances × POOL_MAX).
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
# Graceful shutdown. On SIGTERM the API reports NOT ready for
# READINESS_DRAIN_MS while still serving, so the load balancer takes it
# out of rotation before the listener closes; GRACE_MS is the hard
# deadline after which it exits regardless (an open SSE stream would
# otherwise hold the deploy forever). Keep DRAIN above the LB's
# health-check interval and GRACE below the orchestrator's SIGKILL
# (compose: stop_grace_period, Kubernetes:
# terminationGracePeriodSeconds).
#
# The two are ORDERED, NOT ADDITIVE: the drain runs inside the grace
# budget, so DRAIN must stay at least a second below GRACE. A 20s LB
# poll answered with DRAIN=30000 against the default GRACE=20000 does
# not shut down slowly — it exits(1) with the listener still open, the
# pg pool abandoned and in-flight requests cut at the socket, and the
# log line on the way out blames slow clients. Boot now rejects that
# pair rather than accepting it and inverting the shutdown.
SHUTDOWN_READINESS_DRAIN_MS=5000
SHUTDOWN_GRACE_MS=20000
# Signing key for every access token. Prod/staging boot rejects this
# placeholder, anything shorter than 32 characters, and anything with
# fewer than 10 distinct characters (a padded passphrase). Generate the
# real value with:  openssl rand -hex 32
# An HS256 key with low entropy is recoverable offline from one captured
# token, after which any user id can be forged.
JWT_SECRET=change-me-super-secret
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
CORS_ORIGIN=http://localhost:8081,http://localhost:8080
LOG_LEVEL=debug

# OTP
OTP_PROVIDER=mock
OTP_CODE_LENGTH=6
OTP_TTL_MINUTES=10
OTP_RESEND_INTERVAL_SECONDS=60
OTP_MAX_SEND_PER_DAY=10
OTP_MAX_VERIFY_ATTEMPTS=5
# HMAC key over stored OTP codes. Same production bar as JWT_SECRET
# (≥32 chars, ≥10 distinct — `openssl rand -hex 32`): codes are six
# digits, so a recovered key turns the stored hash into a 10^6 lookup.
OTP_HASH_SECRET=change-me-otp-secret
# Internal-test OTP bridge — set OTP_PROVIDER=internal_test to use it.
# A deliberate opt-in for a controlled test window, NOT the only
# available provider: TencentOtpProvider is implemented and wired
# against the real SendSms API (see below). Note that while
# internal_test is active, no genuinely new patient can register —
# only these allowlisted numbers can log in, using OTP_TEST_FIXED_CODE;
# every other number is rejected (403). In prod BOTH must be set or
# startup fails (allowlist non-empty, code = OTP_CODE_LENGTH digits).
# Numbers may be written bare (13922220001) OR with the country code
# (+8613922220001), comma-separated — both normalize to the same +86
# form the mobile app actually sends, so either matches a real login.
# Switch OTP_PROVIDER=tencent once real SMS lands.
OTP_TEST_PHONE_ALLOWLIST=
OTP_TEST_FIXED_CODE=
# Tencent Cloud SMS — set OTP_PROVIDER=tencent for real SMS delivery.
# All five below are REQUIRED when the provider is tencent (prod
# fail-fasts naming any that are missing). The approved SMS template
# MUST have exactly two variables — {1}=verification code, {2}=TTL
# minutes — matching what TencentOtpProvider sends, e.g.:
#   您的验证码{1}，请于{2}分钟内填写，如非本人操作请忽略本短信。
# Credentials come from the Tencent Cloud SMS console (SecretId/Key from
# 访问管理 CAM; SdkAppId/SignName/TemplateId from 短信控制台).
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=20
OTP_SEND_RATE_LIMIT_WINDOW_SECONDS=60
OTP_SEND_RATE_LIMIT_MAX_REQUESTS=5
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# AI (Node API)
# Note: AI_API_MODEL here must match `env.ts`'s default
# (`deepseek-ai/DeepSeek-V3`) — if a user copies `.env.example` →
# `.env` and removes this line, the runtime falls back to env.ts's
# default, NOT what they thought they were running. Keep these two
# in lockstep when changing the default model.
#
# ⚠️ SiliconFlow runs TWO independent platforms — .cn (国内站) and .com
# (international). Accounts, API keys, balances, and model catalogs do
# NOT carry across: a key minted on cloud.siliconflow.COM returns 401
# "Api key is invalid" against api.siliconflow.CN, and vice-versa. Match
# this URL to the console your key came from — cloud.siliconflow.cn →
# keep .cn below; cloud.siliconflow.com → switch host to
# api.siliconflow.com AND pick AI_API_MODEL from the .com catalog (the
# model IDs differ too, e.g. .com's zai-org/GLM-5.2 vs .cn's
# deepseek-ai/DeepSeek-V3).
#
# ⚠️ SWITCHING THE HOST OFF `.cn` IS NOT ONLY AN ACCOUNT DECISION. Every
# prompt carries the patient's free-text question plus consent-gated
# clinical fields, so a non-mainland endpoint makes this deploy a
# cross-border transfer of health-related personal information: PIPL
# Art. 38-39 then require a CAC security assessment or a filed standard
# contract, separate cross-border consent, and disclosure of the
# overseas recipient. Prod boot refuses a non-`.cn` host until the
# acknowledgement flag below records that this was a decision.
AI_API_BASE_URL=https://api.siliconflow.cn/v1
AI_CROSS_BORDER_ACKNOWLEDGED=false
AI_API_MODEL=deepseek-ai/DeepSeek-V3
AI_API_TIMEOUT=30000
# Ceiling on tool-executing rounds. Each round is one full-context LLM
# call plus a batch of retrievals, so this is the dial between answering
# a two-step question ("read my report, then look up what it means") and
# how long a patient waits. Measured: one round 14-16s, two 21-30s.
AI_MAX_TOOL_ROUNDS=3
# Multi-turn history budget the SERVER enforces on client-replayed
# conversation: at most this many prior turns and this many total chars
# (~2.7k tokens of Chinese at 8000 — planner + final round each pay that
# input cost). Tune down to cut LLM spend without shipping a client.
AI_HISTORY_MAX_MESSAGES=12
AI_HISTORY_CHAR_BUDGET=8000
# At least ONE of these is REQUIRED in prod/staging — boot fails without
# it. Miss it and everything looks healthy (clean boot, 200 on
# /healthz/ready, healthy container) while every patient question
# answers「AI 服务未配置」 and document summaries return 500. The
# symptom reads as low usage, not as a misconfiguration.
OPENAI_API_KEY=
AI_API_KEY=
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_RATE_LIMIT_MAX_REQUESTS=6
AI_PROGRESS_RATE_LIMIT_WINDOW_SECONDS=60
AI_PROGRESS_RATE_LIMIT_MAX_REQUESTS=30

# OCR (Baidu)
# Both keys are REQUIRED in prod/staging when OCR_PROVIDER=baidu — the
# provider factory otherwise falls through to the embedded parser
# without an error, silently changing which engine parses every patient
# document.
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
BAIDU_OCR_GENERAL_ENDPOINT=https://aip.baidubce.com/rest/2.0/ocr/v1/general_basic
BAIDU_OCR_ACCURATE_ENDPOINT=https://aip.baidubce.com/rest/2.0/ocr/v1/accurate_basic
BAIDU_OCR_MEDICAL_ENDPOINT=https://aip.baidubce.com/rest/2.0/ocr/v1/medical_report

# Integrated report OCR / parser
OCR_PROVIDER=embedded
OCR_PYTHON_BIN=python3
# Wall clock for ONE embedded parse. Was 120000 here long after env.ts
# moved its default to 300000 — and an explicit .env value beats that
# default, so every deploy made by the documented `cp .env.example .env`
# silently reverted the fix. 120s is the wrong side of the measured cost
# (~103s warm, single document): parses that were working perfectly died
# as「识别失败」. See the docblock on OCR_PARSER_TIMEOUT_MS in
# apps/api/src/config/env.ts — keep the two in lockstep.
OCR_PARSER_TIMEOUT_MS=300000
OCR_DISABLE_PADDLE=true
# Page cap for PDF OCR, read by the api container only (it is passed
# through docker-compose.yml's api `environment:` block). Exceeding it
# raises a user-facing error instead of silently truncating a medical
# record — which is why it is a cap and not a "best effort" limit.
OCR_MAX_PDF_PAGES=30

# File storage
# Prod/staging must use minio. The minio service is in BOTH the `minio`
# and `prod` compose profiles, so `docker compose --profile prod up -d`
# starts it — no second `--profile minio` needed (this line used to say
# the opposite, which cost a redundant flag rather than a broken
# deploy). Booting prod on
# `local` requires STORAGE_ALLOW_LOCAL=true, an explicit statement that
# patient PDFs, MRI images and genetic reports live on the container's
# own volume and that YOUR backup procedure covers it.
STORAGE_PROVIDER=local
STORAGE_ALLOW_LOCAL=false
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin12345678
MINIO_BUCKET_NAME=medical-reports
# TLS to the object store. Compose-internal `minio:9000` is a docker
# bridge hop and needs none — but say so with MINIO_ALLOW_INSECURE=true,
# because for a REMOTE / managed S3-compatible endpoint this same
# `false` puts the access key, the secret key and the raw bytes of every
# scanned hospital report on the wire in cleartext. Prod boot fails
# unless one of the two is set.
MINIO_USE_HTTPS=false
MINIO_ALLOW_INSECURE=false

# Chroma Cloud
#
# As of v2.4.0 the KB lives in local pgvector and the API no longer
# reads Chroma at runtime. The vars below are only required by the
# one-shot migration / re-ingest scripts in `scripts/`:
#   - kb-import-from-chroma.py — pulls historical corpus from Chroma
#     Cloud and re-embeds into pgvector
#   - kb-ingest.* — accepts `--dry-run --source chroma` for spot
#     checks
# Leave empty / placeholder if you don't need to touch Chroma.
CHROMA_API_KEY=your_chromadb_cloud_api_key_here
CHROMA_TENANT_ID=your_tenant_id_here
CHROMA_DATABASE=FSHD
CHROMA_COLLECTION=fshd_knowledge_base
CHROMA_API_HOST=localhost
CHROMA_API_PORT=5000

# Knowledge service
KB_SERVICE_HOST=127.0.0.1
KB_SERVICE_PORT=5010
KB_SERVICE_URL=
# Shared bearer token between the Node API and the Python KB service.
# Both sides MUST see the same value (docker-compose wires both
# containers from this single env). The KB service refuses to start
# without this set when KB_SERVICE_HOST is 0.0.0.0 (the docker-compose
# case) or the environment is production, so a non-loopback bind can
# never accidentally expose the KB to anonymous callers.
#
# Generate a real value with one of:
#   openssl rand -hex 32
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# Required in staging / production. May be left empty for plain
# loopback dev where the Node API runs natively (no docker) and the
# KB service binds to 127.0.0.1. When using `docker compose up` the
# compose file falls back to a `dev-only-local-token-NOT-FOR-PROD`
# placeholder so a fresh clone works without touching this — but you
# can override here to test the real auth path locally.
KB_SERVICE_TOKEN=
KB_READY_WAIT_SECONDS=90
HEALTHCHECK_TIMEOUT_MS=2500
# Retrieval width for the Python KB service (knowledge_service.py reads
# these directly from the environment). FETCH_K is how many chunks the
# vector search pulls before re-ranking, FINAL_N how many survive into
# the prompt, MAX_PER_SOURCE the cap that stops one long document from
# filling the whole answer. These are the dials to reach for when
# answers are thin (raise FINAL_N) or when LLM input cost is the
# problem (lower it); they had no record anywhere until now.
KB_FETCH_K=80
KB_FINAL_N=8
KB_MAX_PER_SOURCE=4
# Override only when the Docker kb-service should read from a Postgres
# instance other than the compose `postgres` service — typically when
# you ingested into native pg and want the container to reach it via
# host.docker.internal. See docs/proposals/local-rag-migration.md §4.4.
KB_SERVICE_DATABASE_URL=

# Knowledge base backend
# Switch between the local pgvector store (default) and Chroma Cloud
# (kept as a one-flag fallback). See docs/proposals/local-rag-migration.md.
KB_BACKEND=pgvector
KB_EMBED_MODEL=BAAI/bge-m3
# HuggingFace endpoint for downloading the embedding model on first
# boot. Defaults to the mirror because this platform deploys on
# mainland-China servers, where huggingface.co is blocked — the same
# decision apps/api/Dockerfile.kb already made for PIP_INDEX_URL. With
# the direct host, a first deploy (or any deploy after
# `docker volume rm kb-model-cache`) hangs on "Network is unreachable",
# the kb-service healthcheck burns its full 7.5 min budget, and because
# api depends_on kb-service: service_healthy the ENTIRE site fails to
# come up — not just AI chat.
# Outside mainland China set HF_ENDPOINT=https://huggingface.co. Never
# set it to an empty value: huggingface_hub treats "" as a broken
# host-less endpoint rather than as unset.
HF_ENDPOINT=https://hf-mirror.com
KB_INGEST_BATCH_SIZE=32
# Search admission control + connection pool sizing for the pgvector
# backend. Defaults (2 concurrent searches, pool 1/2) fit the current
# single-process KB service; raise the max when adding workers.
#
# Keep KB_MAX_CONCURRENT_SEARCHES and KB_PG_POOL_MAX moving together —
# raising one alone just relocates the queue into psycopg's pool
# timeout, where it surfaces as a different error for the same cause.
# KB_SEARCH_QUEUE_WAIT_SECONDS must stay below medical-kb.ts's 30s
# client timeout, so a shed request comes back as a 503 kb_busy the API
# can explain rather than as a client-side abort.
KB_MAX_CONCURRENT_SEARCHES=2
KB_SEARCH_QUEUE_WAIT_SECONDS=20
KB_PG_POOL_MIN=1
KB_PG_POOL_MAX=2

# GitHub App reviewer (see docs/github-app-reviewer.md)
# `npm run github:app-token` / `npm run github:app-pr-review` will read
# these via Node's --env-file-if-exists=.env. PEM file lives outside the
# repo (typically ~/.config/openrd/review-bot.pem with chmod 600).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_REPOSITORY=OpenRareDisease/openrd
# Optional. The scripts resolve installation id from --repo when this
# is unset, but setting it skips one round-trip to GitHub. Find it
# under https://github.com/settings/installations/<id> after
# installing the App.
GITHUB_APP_INSTALLATION_ID=

# Reverse proxy / HTTPS (prod only)
# The `caddy` service (docker-compose `prod` profile) terminates TLS
# for this domain and auto-obtains + renews a Let's Encrypt cert. Read
# by Caddyfile as the site address. Local dev leaves it unset — caddy
# isn't started without `docker compose --profile prod`.
DOMAIN=ai.fshdyouth.com

# Mobile (Expo)
# Dev points the app straight at the local API. PROD must point the
# mobile app at the public HTTPS origin so traffic goes through Caddy:
#   EXPO_PUBLIC_API_URL=https://ai.fshdyouth.com/api
# (rebuild the app after changing). The web build uses a same-origin
# relative path, so WEB_EXPO_PUBLIC_API_URL=/api is correct everywhere.
EXPO_PUBLIC_API_URL=http://localhost:4000/api
WEB_EXPO_PUBLIC_API_URL=/api
# Build-time feature flags (apps/mobile/lib/feature-flags.ts). Both are
# OFF by design — they hide pre-launch placeholder screens — and they
# are read at BUNDLE time, so flipping one here only has an effect if
# the value also reaches the bundler (for the compose web build that
# means adding it to the web service's `args:` block, alongside
# EXPO_PUBLIC_API_URL). Listed here so the next person who wants to demo
# 探索 or the accessibility settings knows the flags exist.
# EXPO_PUBLIC_ENABLE_EXPLORE=false
# EXPO_PUBLIC_ENABLE_PERSONALIZATION=false
