# Caddy — reverse proxy + automatic HTTPS for the openrd prod stack.
#
# Caddy obtains and auto-renews a Let's Encrypt cert for the domain
# below via the HTTP-01 challenge. Prereqs (both already in place for
# ai.fshdyouth.com → the prod server):
#   - the domain's A record points at this host
#   - port 80 is reachable from the public internet (for the challenge)
#
# Routing:
#   /api/*  → api:4000   Node API. `flush_interval -1` disables response
#                        buffering so the SSE endpoint
#                        (/api/ai/ask/stream) streams tokens to the
#                        mobile client in real time instead of being
#                        held until the response closes.
#   /*      → web:80     The Expo web build (static).
#
# Upstreams are reached over the compose network by service name, so
# they don't publish public host ports (they're bound to 127.0.0.1 in
# docker-compose.yml). Caddy is the only service on 0.0.0.0:80/443.
#
# The site address is parameterised: set DOMAIN in prod `.env`
# (docker-compose passes it through). Defaults to ai.fshdyouth.com.
{
	# ACME account email — Let's Encrypt sends cert-expiry + account
	# notices here. Not validated by LE, but use an inbox you monitor.
	email admin@fshdyouth.com
}

{$DOMAIN:ai.fshdyouth.com} {
	# Security headers for the whole site — both the static app and /api.
	#
	# Nothing set these before. The API's helmet() covers only responses the
	# Node process produces, and Caddy routes /* straight to the nginx
	# container, so the signed-in patient UI was framable by any third party:
	# a plain clickjacking surface over runDeleteReport in p-report_management
	# and the seven consent toggles in p-privacy_settings. X-Frame-Options is
	# set here rather than only in nginx.conf so it also covers /api, and
	# because Caddy is the only listener the public actually reaches.
	#
	# HSTS is a commitment: for a year after a browser sees this header it
	# will refuse plain HTTP to this host, so the domain can never be served
	# over http again without waiting the max-age out. That is the right
	# trade for a PHI app that already redirects http→https, but `preload` is
	# deliberately NOT set — that one is removable only by petition.
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "geolocation=(), microphone=(), payment=(), usb=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	handle /api/* {
		reverse_proxy api:4000 {
			# Stream SSE (/api/ai/ask/stream) without buffering.
			flush_interval -1
		}
	}

	# The one public surface a stranger's browser loads: /s/passport/:token
	# is the clinical passport a patient forwards to a clinician in WeChat,
	# and /s/passport/pickup is the form behind the QR code they hold up
	# across a consulting-room desk. It is mounted OUTSIDE /api on purpose
	# (routes/index.ts says why: /api carries auth, CORS and JSON error
	# envelopes shaped for our own client), which means it needs its own
	# route here — the /api/* block above does not match it and the
	# catch-all below hands it to the static app.
	#
	# Without this block the whole feature is silently dead in production:
	# nginx's try_files answers /s/passport/<token> with index.html at 200,
	# expo-router finds no such route and renders +not-found, and the
	# clinician sees a Chinese consumer app's not-found screen. The share
	# row is minted and opened_count stays 0, so the patient's revoke list
	# tells them the doctor never opened it. scripts/smoke-test.sh checks
	# this path for exactly that reason.
	handle /s/* {
		reverse_proxy api:4000
	}

	handle {
		# frame-ancestors is scoped to the app rather than set site-wide on
		# purpose: a site-level Content-Security-Policy would REPLACE the
		# fuller policy helmet already emits on /api responses, trading its
		# default-src/base-uri/form-action rules for this single directive.
		# The API keeps helmet's; the static app, which has no helmet in
		# front of it, gets this. nginx.conf sets the same value for the
		# paths that reach that container without passing through Caddy.
		header Content-Security-Policy "frame-ancestors 'none'"
		reverse_proxy web:80
	}

	encode gzip
}
